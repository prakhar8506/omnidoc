<?xml version="1.0" encoding="utf-8"?>
<!-- Release trusts system CAs only. Debug overrides cleartext in the debug manifest. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
