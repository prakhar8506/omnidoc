<?xml version="1.0" encoding="utf-8"?>
<!--
  Health data must never leave the device through Google backup or a
  device-to-device transfer. Everything Cura writes locally (journal entries,
  mood checks, cycle and pregnancy logs, medications, emergency contacts) is
  excluded from both channels.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
