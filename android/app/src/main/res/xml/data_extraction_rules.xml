<?xml version="1.0" encoding="utf-8"?>
<!--
  Health data is encrypted on the phone and is excluded from cloud backup
  and device transfer. An update keeps the app's private storage. Uninstall
  removes it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="external" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="external" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
